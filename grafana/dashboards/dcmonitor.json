      "targets": [
        {
          "query": "from(bucket: \"fdctmon\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"ambiente\" and r._field == \"temperatura\")\n  |> group(columns: [\"device_id\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> filter(fn: (r) => exists r.local and exists r.nome and contains(value: r.local, set: ${local:json}) and contains(value: r.nome, set: ${dispositivo:json}))\n  |> map(fn: (r) => ({local: r.local, nome: r.nome, device_id: r.device_id, ultimo: r._time, idade_s: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0, temperatura: r._value}))\n  |> group()\n  |> sort(columns: [\"idade_s\"], desc: true)",
          "refId": "A"
        }
      ],
      "title": "Situação das placas",
      "type": "table"
