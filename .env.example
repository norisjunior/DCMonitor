# Copie este arquivo para .env e preencha os valores antes de rodar docker compose up
# NUNCA commite o arquivo .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=fdctmon
POSTGRES_USER=fdctmon
POSTGRES_PASSWORD=troque_esta_senha

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=troque_esta_senha
# Chave de 32+ chars para criptografar credenciais salvas no n8n
N8N_ENCRYPTION_KEY=gere_uma_chave_aleatoria_aqui

# ── Flask dashboard ───────────────────────────────────────────────────────────
# Minutos sem receber medição para considerar dispositivo offline
DEVICE_OFFLINE_THRESHOLD_MINUTES=2

# ── Referência (usado nos fluxos n8n e no script do Pi) ──────────────────────
# Endereço do broker Mosquitto visto pelo Pi (IP do servidor na rede 192.168.x.x)
MQTT_BROKER_HOST=192.168.x.x
MQTT_BROKER_PORT=1883
MQTT_USERNAME=fdctmon_iot
MQTT_PASSWORD=troque_esta_senha_mqtt

# Endereço do Zabbix (usado pelo n8n para chamar zabbix_sender)
ZABBIX_SERVER=10.32.8.57
ZABBIX_HOST_NAME=SALA COFRE
