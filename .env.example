# Copie para .env e substitua todos os valores TROQUE_* antes de subir a stack.
# O arquivo .env é ignorado pelo Git.

TZ=America/Sao_Paulo

# Bind no host Docker. 0.0.0.0 aceita conexoes por qualquer interface de rede.
# Para acessar, use o IP atual 10.32.8.115 ou, futuramente, o nome DNS.
BIND_ADDRESS=0.0.0.0

# Mosquitto. As placas usam a porta 8883 (TLS), cada uma com usuário = device_id
# e senha própria gerada na página /admin/. MQTT_ADMIN_* é o login do Node-RED
# na porta interna 1884, que também administra as credenciais das placas.
MQTT_ADMIN_USER=node-red
# Ao menos 24 caracteres; gere com: openssl rand -base64 32
MQTT_ADMIN_PASSWORD=TROQUE_SENHA_ADMIN_MQTT
# Diretórios do host. Crie antes de subir a stack:
#   bash scripts/gerar_certificados.sh            (gera ./pki)
#   install -d -o 1883 -g 1883 ./mqtt-seguranca
MQTT_CERTS_DIR=./pki/mosquitto
MQTT_SEGURANCA_DIR=./mqtt-seguranca

# InfluxDB 2.x. O dashboard provisionado usa o bucket fdctmon.
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=TROQUE_SENHA_INFLUXDB
INFLUXDB_TOKEN=TROQUE_TOKEN_LONGO_E_ALEATORIO
INFLUXDB_ORG=dcmonitor
INFLUXDB_BUCKET=fdctmon
INFLUXDB_RETENTION=2160h

# Node-RED
NODE_RED_CREDENTIAL_SECRET=TROQUE_CHAVE_ALEATORIA_NODE_RED
NODE_RED_ADMIN_USER=admin
# Gere com: docker run --rm -it --entrypoint node-red nodered/node-red:4.1.11 admin hash-pw
# No .env real, envolva o hash em aspas simples para preservar os caracteres $.
NODE_RED_ADMIN_PASSWORD_HASH=TROQUE_HASH_BCRYPT

# Página de cadastro de dispositivos (http://SERVIDOR:1880/admin/).
# Login separado do editor do Node-RED; gere o hash com o mesmo comando acima.
CADASTRO_ADMIN_USER=cadastro
CADASTRO_ADMIN_PASSWORD_HASH=TROQUE_HASH_BCRYPT_CADASTRO
# Diretório do host com dispositivos.json. Crie antes de subir a stack:
#   install -d -o 1000 -g 1000 ./cadastro
CADASTRO_DIR=./cadastro

# n8n usa autenticação própria configurada no primeiro acesso.
N8N_ENCRYPTION_KEY=TROQUE_CHAVE_ALEATORIA_N8N_COM_32_OU_MAIS_CARACTERES

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=TROQUE_SENHA_GRAFANA

# Zabbix trapper. O fluxo do Node-RED envia para o host homônimo ao device_id
# do dispositivo, com as chaves: temp, umid, headindex, rssi
ZABBIX_SERVER=10.32.8.57
ZABBIX_PORT=10051
# Segundo servidor Zabbix, que recebe os mesmos itens. Deixe vazio para desligar.
ZABBIX_SERVER_2=10.32.8.69

# Usado somente pelo fluxo de contingência do n8n, que envia a um host fixo
ZABBIX_HOST_NAME=esp32-18B4C0D8CBB0
