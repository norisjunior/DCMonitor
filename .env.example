# Copie para .env e substitua todos os valores TROQUE_* antes de subir a stack.
# O arquivo .env é ignorado pelo Git.

TZ=America/Sao_Paulo

# Bind no host Docker. 0.0.0.0 aceita conexoes por qualquer interface de rede.
# Para acessar, use o IP atual 10.32.8.115 ou, futuramente, o nome DNS.
BIND_ADDRESS=0.0.0.0

# Dispositivos -> Mosquitto (porta externa 1883)
MQTT_USERNAME=fdctmon_iot
MQTT_PASSWORD=TROQUE_SENHA_MQTT

# InfluxDB 2.x. O dashboard provisionado usa o bucket fdctmon.
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=TROQUE_SENHA_INFLUXDB
INFLUXDB_TOKEN=TROQUE_TOKEN_LONGO_E_ALEATORIO
INFLUXDB_ORG=dcmonitor
INFLUXDB_BUCKET=fdctmon
INFLUXDB_RETENTION=2160h

# Node-RED
NODE_RED_CREDENTIAL_SECRET=TROQUE_CHAVE_ALEATORIA_NODE_RED
NODE_RED_ADMIN_USER=admin
# Gere com: docker run --rm -it --entrypoint node-red nodered/node-red:4.1.11 admin hash-pw
# No .env real, envolva o hash em aspas simples para preservar os caracteres $.
NODE_RED_ADMIN_PASSWORD_HASH=TROQUE_HASH_BCRYPT

# n8n usa autenticação própria configurada no primeiro acesso.
N8N_ENCRYPTION_KEY=TROQUE_CHAVE_ALEATORIA_N8N_COM_32_OU_MAIS_CARACTERES

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=TROQUE_SENHA_GRAFANA

# Zabbix trapper, usado pelo fluxo do Node-RED. Os itens devem existir no host
# com estas chaves: temperatura, umidade, indice_calor, rssi
ZABBIX_SERVER=10.32.8.57
ZABBIX_PORT=10051
ZABBIX_HOST_NAME=SALA COFRE
